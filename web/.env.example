# Browser-exposed (VITE_ prefix → bundled into the React app):
VITE_SF_MYDOMAIN=https://<your-domain>.my.salesforce.com
VITE_AGENT_ID=
VITE_CLIENT_ID=
VITE_ACCESS_TOKEN=

# Server-only (NOT VITE_-prefixed, so Vite never ships these to the browser).
# Mint VITE_ACCESS_TOKEN yourself from the client_credentials flow — see the README curl.
SF_CLIENT_SECRET=          # Agent-API ECA consumer secret (pairs with VITE_CLIENT_ID; used to mint the token)
SLACK_BOT_TOKEN=           # xoxb-… bot token (optional; Module 5 Slack)
ORG_ALIAS=<your-alias>
